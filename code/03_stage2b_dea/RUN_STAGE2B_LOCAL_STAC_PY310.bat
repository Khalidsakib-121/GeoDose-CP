@echo off\nsetlocal\ncd /d "%~dp0"\nset PY=.venv\Scripts\python.exe\nif not exist "%PY%" set PY=..\.venv\Scripts\python.exe\nif not exist "%PY%" goto :nopy\n"%PY%" -m pip check\nif errorlevel 1 goto :fail\n"%PY%" stage2b_local_stac_prescreen.py --self-test\nif errorlevel 1 goto :fail\n"%PY%" stage2b_local_stac_prescreen.py --input inputs --connection-test\nif errorlevel 1 goto :fail\n"%PY%" stage2b_local_stac_prescreen.py --input inputs --output outputs\nif errorlevel 1 goto :fail\n"%PY%" verify_stage2b_local_stac.py --input inputs --output outputs\nif errorlevel 1 goto :fail\npowershell -NoProfile -Command "Compress-Archive -Path outputs\* -DestinationPath GeoDose_Stage2B_OUTPUTS_LOCAL_STAC.zip -Force"\nif errorlevel 1 goto :fail\necho.\necho STAGE 2B LOCAL STAC RUN FINISHED SUCCESSFULLY\necho Output ZIP: %~dp0GeoDose_Stage2B_OUTPUTS_LOCAL_STAC.zip\npause\nexit /b 0\n:nopy\necho Could not find .venv Python in this folder or its parent.\npause\nexit /b 2\n:fail\necho.\necho STAGE 2B LOCAL STAC FAILED. Existing verified checkpoints remain.\npause\nexit /b 1\n